{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/guida",
      "destination": "/guida/index.html"
    },
    {
      "source": "/store-locator",
      "destination": "/store-locator.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
